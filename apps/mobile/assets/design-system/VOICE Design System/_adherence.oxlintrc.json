{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/avatar/**",
              "components/core/**",
              "components/data/**",
              "components/feedback/**",
              "components/forms/**",
              "ui_kits/mobile-app/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Manrope|JetBrains Mono))/i]",
        "message": "Font not provided by the design system. Available: Manrope, JetBrains Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='AvatarOrb'] > JSXAttribute > JSXIdentifier[name!=/^(?:state|tier|size|waveform|label|hapticStandIn|key|ref|className|style|children)$/]",
        "message": "<AvatarOrb> doesn't accept that prop. Declared props: state, tier, size, waveform, label, hapticStandIn."
      },
      {
        "selector": "JSXOpeningElement[name.name='AvatarOrb'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:idle|listening|analyzing|coaching|celebrating|playback)$/]",
        "message": "<AvatarOrb> state must be one of 'idle' | 'listening' | 'analyzing' | 'coaching' | 'celebrating' | 'playback'."
      },
      {
        "selector": "JSXOpeningElement[name.name='AvatarOrb'] > JSXAttribute[name.name='tier'] > Literal[value!=/^(?:speaking|singing)$/]",
        "message": "<AvatarOrb> tier must be one of 'speaking' | 'singing'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: children, tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:accent|success|warning|danger)$/]",
        "message": "<Badge> tone must be one of 'accent' | 'success' | 'warning' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|disabled|onClick|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, size, disabled, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|muted|danger)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'muted' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CoachingCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:praise|tip|key|ref|className|style|children)$/]",
        "message": "<CoachingCard> doesn't accept that prop. Declared props: praise, tip."
      },
      {
        "selector": "JSXOpeningElement[name.name='LevelMeter'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|key|ref|className|style|children)$/]",
        "message": "<LevelMeter> doesn't accept that prop. Declared props: value."
      },
      {
        "selector": "JSXOpeningElement[name.name='OptionChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|selected|onClick|key|ref|className|style|children)$/]",
        "message": "<OptionChip> doesn't accept that prop. Declared props: children, selected, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='ScoreCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:score|isBest|key|ref|className|style|children)$/]",
        "message": "<ScoreCard> doesn't accept that prop. Declared props: score, isBest."
      },
      {
        "selector": "JSXOpeningElement[name.name='ToggleRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|description|checked|onChange|key|ref|className|style|children)$/]",
        "message": "<ToggleRow> doesn't accept that prop. Declared props: title, description, checked, onChange."
      },
      {
        "selector": "JSXOpeningElement[name.name='XPCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:xp|key|ref|className|style|children)$/]",
        "message": "<XPCard> doesn't accept that prop. Declared props: xp."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
